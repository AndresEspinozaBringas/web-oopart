# Cabeceras de Cloudflare Workers Static Assets.
#
# OJO: Cloudflare ACUMULA todas las reglas cuyo patron coincide, no gana la
# mas especifica. Una regla /* al final le pegaba "max-age=0, must-revalidate"
# a todo y dejaba cabeceras con dos max-age contradictorios, que el navegador
# resuelve quedandose con el primero. Por eso aca ningun patron se solapa.
#
# El HTML no necesita regla: Cloudflare ya lo sirve con max-age=0,
# must-revalidate, que es justo lo que queremos (es lo que cambia al publicar
# y lo que apunta a las versiones nuevas de todo lo demas).

# CSS y JS llevan ?v=<hash> del contenido (scripts/version-assets.mjs): si
# cambian, cambia la URL, asi que la copia guardada nunca queda obsoleta y el
# navegador no tiene por que volver a preguntar.
/styles.css
  Cache-Control: public, max-age=31536000, immutable
/app.js
  Cache-Control: public, max-age=31536000, immutable
/consent.js
  Cache-Control: public, max-age=31536000, immutable
/analytics.js
  Cache-Control: public, max-age=31536000, immutable

# Fuentes, logos, iconos e imagenes para redes. No llevan hash, asi que
# reemplazar uno sin renombrarlo dejaria a los visitantes con la version
# vieja: un mes evita revalidar en cada visita sin atarnos un ano.
/assets/*
  Cache-Control: public, max-age=2592000
